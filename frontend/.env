# Serve the React dev server over HTTPS too.
#
# Why bother, when only the backend sets the cookie? Because a "Secure" cookie
# is only stored and sent back on a connection the browser considers secure.
# Chrome and Firefox make a special exception for http://localhost, so it would
# mostly work without this — but Safari does not, and relying on a browser
# quirk to demo a security feature is a bad look. Turning it on here makes the
# development setup behave like production.
#
# Create React App generates its own throwaway certificate, so the browser will
# warn once on https://localhost:3000. Click through it — that warning is the
# certificate check working, not a failure.
HTTPS=true
PORT=3000
