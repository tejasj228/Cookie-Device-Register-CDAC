<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- This parent gives us sensible default versions for every Spring library. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>cookie-demo</artifactId>
    <version>1.0.0</version>
    <name>cookie-demo</name>
    <description>Login / Register demo that remembers you using a browser cookie</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Lets us build REST endpoints (@RestController) and run a web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lets us save Java objects into a database without writing SQL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            H2: a tiny database that lives inside our app as a file. No install
            needed. Still the default for local development and for the test
            suite — nobody should need a Postgres server to run `mvnw test`.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            PostgreSQL, for the deployed copy (Neon).

            Both drivers ship in the same jar and that is fine: a JDBC driver is
            inert until something asks for it. Spring picks one by looking at
            spring.datasource.url — a jdbc:h2: URL loads H2, a jdbc:postgresql:
            URL loads this. Which means the SAME build artifact runs on a laptop
            against a file and in production against Neon, with one environment
            variable as the difference and no build-time profile to get wrong.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            JUnit 5 + MockMvc + AssertJ, all in one. "test" scope means it is
            available to src/test/java only and is never shipped in the jar.
            This is what SessionSecurityTest uses to prove the cookie really
            carries HttpOnly / Secure / SameSite and really is just an id.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
